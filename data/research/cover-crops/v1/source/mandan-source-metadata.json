 "is_mandatory": false}, {"name": "ARS National Program Number", "value": ["216"], "settings": {"options": ["101", "103", "104", "106", "107", "108", "211", "212", "215", "216", "301", "303", "304", "305", "306", "Other"], "placeholder": "ARS National Program Number", "is_multiple": true}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "ARIS Log Number", "value": "418267", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "ARIS Log Number"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Primary article PubAg Handle", "value": [], "settings": {"placeholder": "LEAVE THIS FIELD BLANK - ADMINISTRATIVE USE ONLY", "is_multiple": true}, "field_type": "url", "order": null, "is_mandatory": false}, {"name": "Pending citation", "value": ["No"], "settings": {"options": ["Yes", "No"], "default_value": ["No"], "is_multiple": false}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "Related material without URL", "value": "", "settings": {"validations": {"min_length": 10, "max_length": 2000}, "placeholder": "Related material without URL"}, "field_type": "textarea", "order": null, "is_mandatory": false}, {"name": "Public Access Level", "value": ["Public"], "settings": {"options": ["Public"], "default_value": ["Public"], "is_multiple": false}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "Preferred dataset citation", "value": "", "settings": {"validations": {"min_length": 3, "max_length": 10000}, "placeholder": "Preferred dataset citation"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://agdatacommons.nal.usda.gov/articles/dataset/Data_from_Late-Seeded_Cover_Crops_in_a_Semiarid_Environment_Overyielding_Dominance_and_Subsequent_Crop_Yield/26836453", "download_disabled": false, "description": "<p dir=\"ltr\">Interest in cover crops is increasing but information is limited on incorporating them into crop rotations especially in the relatively short growing season on the northern Great Plains. A three-year study, initiated in 2009 on the AREA IV Soil Conservation Districts Cooperative Research Farm near Mandan, North Dakota, USA, evaluated 1) what impact cover crops may have on subsequent crops yields and 2) whether cover crop mixtures are more productive and provide additional benefits compared to cover crop monocultures. The study evaluated 18 different cover crop monocultures and mixtures that were seeded in August into dry pea residue (Pisum sativum L.). Biomass yield of the cover crops was collected by species following a killing frost the same year the cover crops were seeded. The following year, spring wheat (Triticum aestivum L.), corn (Zea mays L.), soybean (Glycine max L.) and dry pea were seeded into the different cover crop treatments and a non-treated control. Yield, test weight, crop moisture percent and thousand kernel weight (TKW) were collected for each crop by cover crop combination. This data can be used to understand biomass yields of late-seeded cover crop monocultures and mixtures and their effect on subsequent annual crops under rainfed conditions in a semi-arid continental climate. Applicable USDA soil types include Grassna, Linton, Mandan, Temvik, Williams, and Wilton.</p>", "funding": "USDA-ARS: 5445-21660-001-00D", "funding_list": [{"id": 25830739, "title": "USDA-ARS: 5445-21660-001-00D", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 293583, "created_date": "2024-10-17T17:35:03Z", "modified_date": "2025-11-21T23:29:06Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 2, "name": "CC0", "url": "https://creativecommons.org/publicdomain/zero/1.0/"}, "tags": ["Cool-season cover crops", "Warm-season cover crops", "Diversity indices", "growing degree days (GDD)", "Semi-arid cropping system", "Nor