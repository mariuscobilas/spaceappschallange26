  "numeric_inputs": [
    "previous_moisture_m3_m3",
    "irrigation_mm",
    "cover_active",
    "days_since_cover_planting",
    "days_since_cover_termination",
    "rain_mm",
    "temperature_max_c",
    "temperature_min_c",
    "humidity_pct",
    "wind_speed_m_s",
    "solar_radiation_mj_m2_day"
  ],
  "seasonal_features": "Derive from date with shared training/serving code in the model task; not fitted here.",
