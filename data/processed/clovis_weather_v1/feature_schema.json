  "units": {
    "humidity_pct": "%",
    "irrigation_mm": "mm/day",
    "moisture_change_m3_m3": "m3/m3 per one-day step",
    "previous_moisture_m3_m3": "m3/m3",
    "rain_mm": "mm/day",
    "solar_radiation_mj_m2_day": "MJ/m^2/day",
