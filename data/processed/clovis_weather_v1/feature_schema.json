{
  "categorical_inputs": [
    "treatment",
    "management_phase"
  ],
  "evaluation_only_columns": [
    "soil_moisture_m3_m3"
  ],
  "metadata_only_columns": [
    "site_id",
    "date",
    "previous_date",
    "partition",
    "sensor_depth_cm",
    "source_id",
    "weather_source",
    "weather_time_standard"
